# Copiar a .env y completar. NO commitear .env.
# El sitio no usa base de datos: dominio, nombre y tracking IDs viven en
# content/site.php. Aca queda solo lo que cambia entre entornos.

APP_ENV=production
APP_DEBUG=false
APP_TZ=UTC

# Solo para desarrollo local: fuerza el dominio activo sin tocar /etc/hosts.
# DEV_SITE_DOMAIN=capacero.online
