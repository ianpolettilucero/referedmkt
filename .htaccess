# Root-level fallback: si Hostinger sirve desde el root del repo y no desde
# /public, redirige todo a public/ para que el front controller reciba las
# requests.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Bloqueo explicito de carpetas que nunca deben servirse directo.
RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 /config(/|$)
RedirectMatch 404 /core(/|$)
RedirectMatch 404 /models(/|$)
RedirectMatch 404 /controllers(/|$)
RedirectMatch 404 /content(/|$)
RedirectMatch 404 /var(/|$)
RedirectMatch 404 /themes(/|$)
RedirectMatch 404 /tests(/|$)
RedirectMatch 404 /bin(/|$)
RedirectMatch 404 /vendor(/|$)
RedirectMatch 404 /\.github(/|$)
